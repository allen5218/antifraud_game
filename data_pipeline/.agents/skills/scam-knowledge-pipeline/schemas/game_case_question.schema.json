{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameCaseQuestionDraft",
  "description": "掛在 game_cases 母案例底下的查證題草稿。母案例已 published 不代表子題可發布。",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_key", "case_key", "question_kind", "question", "options",
               "correct_key", "explanation", "weakness_tag", "difficulty"],
  "properties": {
    "question_key": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
    "version": {"type": "integer", "minimum": 1, "default": 1},
    "case_key": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$",
      "description": "母案例的 case_key；入庫時換成 case_id。"
    },
    "question_kind": {
      "type": "string",
      "enum": ["next_action", "evidence_scope"],
      "description": "next_action=下一步該怎麼查證；evidence_scope=這個證據能證明什麼。"
    },
    "question": {"type": "string", "minLength": 6, "maxLength": 40},
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "text"],
        "properties": {
          "key": {"type": "string", "enum": ["A", "B", "C", "D"]},
          "text": {"type": "string", "minLength": 4, "maxLength": 40}
        }
      }
    },
    "correct_key": {"type": "string", "enum": ["A", "B", "C", "D"]},
    "explanation": {"type": "string", "minLength": 6},
    "weakness_tag": {
      "type": "string",
      "enum": ["time_pressure", "authority", "greed", "social_proof", "trust_building"]
    },
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
    "source_document_ids": {"type": "array", "items": {"type": "integer"}},
    "provenance": {
      "type": ["string", "null"],
      "minLength": 6,
      "description": "查證依據超出母案例時才填；null 代表沿用母案例的 provenance。"
    }
  }
}
