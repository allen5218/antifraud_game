{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Python 版本(backend/Dockerfile 基底映像 + GitHub Actions 的 python-version):只自動合併 patch(小版本臭蟲修正),minor/major(3.10→3.11 或 3.10→3.14 這類 feature release)一律留給人工檢視合併",
      "matchFileNames": ["backend/Dockerfile", ".github/workflows/**"],
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "Playwright 的 npm 套件與測試用 Docker 映像要同一版(套件只認映像裡同版號的瀏覽器),分開升級兩個 PR 都會失敗,所以綁成一組",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright"
    },
    {
      "description": "openapi-ts 釘在 0.73:之後的版本拿掉了 legacy/axios,照現在的設定會產生 0 個檔,升級等於改寫整個前端的 API 呼叫",
      "matchPackageNames": ["@hey-api/openapi-ts"],
      "enabled": false
    }
  ],
  "docker-compose": { "enabled": true },
  "github-actions": { "pinDigests": true }
}
